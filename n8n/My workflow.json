    {
      "parameters": {
        "promptType": "define",
        "text": "=ORIGINAL RESUME:\n\n{{ $('Extract from File').item.json.text }}\n\nATS REPORT:\n\n{{ $('Basic LLM Chain').item.json.text }}\n\nJOB DESCRIPTION:\n\n{{ $('On form submission').item.json[\"Job Description\"] }}\n\nYou are an ATS Resume Optimization Expert.\n\nTASK:\n- Keep original structure.\n- Keep same section names.\n- Improve only necessary content.\n- Add missing keywords naturally.\n- Remove irrelevant content.\n- Do not add fake experience.\n\nIMPORTANT:\nReturn plain text only.\nDo not return JSON.\nDo not return markdown.\nDo not use \\n characters.\nReturn only the final optimized resume.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
