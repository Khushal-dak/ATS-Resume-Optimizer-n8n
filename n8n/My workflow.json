        "jsCode": "const report = $input.first().json.text;\n\nreturn [\n{\njson: {\nreport: report\n.replace(/\\\\n/g, '\\n')\n.replace(/\\\\\"/g, '\"')\n.replace(/\\\\t/g, ' ')\n}\n}\n];"
      },
